---
import "../styles/site.css";
import mark from "../../../src/planacity/resources/images/planacity-mark.png";
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "Open-source program planning for engineering teams. A local workspace for work, timelines, and team capacity.",
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const links = [
  ["Product", `${base}/`],
  ["Get started", `${base}/docs/`],
  ["Roadmap", `${base}/roadmap/`],
];
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={`${title} | Planacity`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={mark.src} />
    <title>{title} | Planacity</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem("planacity-site-theme");
        document.documentElement.dataset.theme =
          saved === "light" || saved === "dark"
            ? saved
            : matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
      } catch {
        document.documentElement.dataset.theme = matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches
          ? "dark"
          : "light";
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#content">
      Skip to content
    </a>
    <header class="site-header">
      <div class="nav-shell">
        <a class="brand" href={`${base}/`} aria-label="Planacity home">
          <img src={mark.src} width="34" height="34" alt="" />
          planacity
        </a>
        <nav aria-label="Main navigation">
          {links.map(([name, href]) => (
            <a
              href={href}
              aria-current={
                Astro.url.pathname.replace(/\/$/, "") ===
                href.replace(/\/$/, "")
                  ? "page"
                  : undefined
              }
            >
              {name}
            </a>
          ))}
        </nav>
        <div class="nav-actions">
          <a class="github-link" href="https://github.com/tidus747/planacity">
            GitHub
          </a>
          <button
            id="theme-toggle"
            class="theme-toggle"
            hidden
            aria-label="Switch appearance"
          >
            <svg class="sun" aria-hidden="true" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
            </svg>
            <svg class="moon" aria-hidden="true" viewBox="0 0 24 24">
              <path d="M20 14a8 8 0 0 1-10-10 8 8 0 1 0 10 10Z" />
            </svg>
          </button>
        </div>
      </div>
    </header>
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer shell">
      <div>
        <a class="brand" href={`${base}/`}>
          planacity
        </a>
        <p>Plan the work. Respect the capacity.</p>
      </div>
      <div class="footer-links">
        <a href={`${base}/docs/`}>Documentation</a>
        <a href={`${base}/roadmap/`}>What's next</a>
        <a href="https://github.com/tidus747/planacity">Source on GitHub</a>
      </div>
      <p class="footer-note">
        Open source. Desktop first. Planning data stays local by default.
      </p>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>("#theme-toggle");
      const system = matchMedia("(prefers-color-scheme: dark)");
      let explicit = false;
      try {
        explicit = ["light", "dark"].includes(
          localStorage.getItem("planacity-site-theme") || "",
        );
      } catch {}
      const update = () => {
        const dark = document.documentElement.dataset.theme === "dark";
        toggle?.setAttribute(
          "aria-label",
          `Switch to ${dark ? "light" : "dark"} mode`,
        );
        toggle?.setAttribute(
          "title",
          `Switch to ${dark ? "light" : "dark"} mode`,
        );
      };
      if (toggle) {
        toggle.hidden = false;
        update();
        toggle.addEventListener("click", () => {
          const next =
            document.documentElement.dataset.theme === "dark"
              ? "light"
              : "dark";
          document.documentElement.dataset.theme = next;
          explicit = true;
          try {
            localStorage.setItem("planacity-site-theme", next);
          } catch {}
          update();
        });
        system.addEventListener("change", () => {
          if (!explicit) {
            document.documentElement.dataset.theme = system.matches
              ? "dark"
              : "light";
            update();
          }
        });
      }
    </script>
  </body>
</html>

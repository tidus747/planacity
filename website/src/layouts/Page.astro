---
interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Open-source program planning for engineering teams." />
    <title>{title} | Planacity</title>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header>
      <a class="brand" href={`${base}/`}>Planacity</a>
      <nav aria-label="Main navigation">
        <a href={`${base}/`}>Home</a>
        <a href={`${base}/roadmap/`}>Roadmap</a>
        <a href="https://github.com/tidus747/planacity">GitHub</a>
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer>Open source. Desktop first. Planning data stays local by default.</footer>
  </body>
</html>

<style is:global>
  :root { font-family: system-ui, sans-serif; color: #203040; background: #f6f8fa; }
  body { max-width: 60rem; margin: auto; padding: 0 1.5rem; line-height: 1.7; }
  header { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem;
    padding: 1.5rem 0; border-bottom: 1px solid #cbd5df; }
  nav { display: flex; gap: 1.5rem; }
  a { color: #155a86; text-underline-offset: .2em; }
  a:focus-visible { outline: 3px solid #155a86; outline-offset: 4px; }
  .brand { font-weight: 750; }
  main { padding: 3rem 0; min-height: 55vh; }
  h1 { font-size: clamp(2rem, 6vw, 3.6rem); line-height: 1.15; max-width: 20ch; }
  h2 { line-height: 1.3; margin-top: 2rem; }
  p, li { max-width: 70ch; }
  .status { border-left: 4px solid #155a86; padding: .5rem 1rem; background: #e9eff4; }
  footer { border-top: 1px solid #cbd5df; padding: 1.5rem 0; font-size: .9rem; }
  .skip { position: absolute; top: -5rem; }
  .skip:focus { top: .5rem; background: white; padding: .5rem; }
</style>
